# GEMINI_API_KEY: Required for photo scanning, receipt reading, and AI recipe drafting.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL where Dinner Spinner is hosted.
APP_URL="MY_APP_URL"

# Upstash Redis (recommended on Vercel/serverless for shared family data).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Google Sign-In client ID for one-tap family group sign-in across phones.
GOOGLE_CLIENT_ID=""

# Web Push (vote notifications). Set VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY, or set a dedicated
# VAPID_SEED secret so rotating GEMINI_API_KEY never invalidates existing phone subscriptions.
VAPID_SEED=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@example.com"
