# GEMINI_API_KEY: Required for photo scanning, receipt reading, and AI recipe drafting.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL where Dinner Spinner is hosted.
APP_URL="MY_APP_URL"

# Upstash Redis (recommended on Vercel/serverless for shared family data).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Google Sign-In client ID for one-tap family group sign-in across phones.
GOOGLE_CLIENT_ID=""

# Web Push (vote notifications). Set VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY, or set a dedicated
# VAPID_SEED secret so rotating GEMINI_API_KEY never invalidates existing phone subscriptions.
VAPID_SEED=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@example.com"

# Household Pro billing (Stripe). Leave blank in local dev to keep all features unlocked.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_PRICE_LIFETIME=""

# Owner allowlist (comma-separated) — guarantees free-forever Pro access for you and your partner.
PRO_OWNER_EMAILS=""
PRO_OWNER_HOUSEHOLDS=""

# Optional live UK affiliate vouchers (Awin Publisher Promotions API: Just Eat, Deliveroo, Gousto, supermarkets).
AWIN_API_TOKEN=""
AWIN_PUBLISHER_ID=""
